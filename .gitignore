!scripts/scan-secrets.sh

# Database files
*.sql
*.sql.gz
*.dump

# Backup files
*.bak
*.backup
*.old

# Coverage & build artifacts
backend/.coverage
frontend/coverage/
frontend/tsconfig.tsbuildinfo
# Playwright E2E artifacts
frontend/test-results/
frontend/playwright-report/

# Assets
assets/webp/

# Docs & reports
# (ignore local scratch docs, but keep the ADR directory and the archive
# README tracked — see gitignore negation rules for nested re-includes)
docs/*
!docs/adr/
!docs/archive/
docs/archive/*
!docs/archive/README.md
CI_CD_IMPLEMENTATION_PLAN.md
FINAL_PRODUCTION_REPORT.md
IMPLEMENTATION_REPORT.md
PHASE1_IMPLEMENTATION_COMPLETE.md
PRODUCTION_DEPLOYMENT_CHECKLIST.md
PRODUCTION_READINESS_CHECKLIST.md
# Local-only merge backup dir (prepare-merge.sh / apply-local-only.sh)
.local-only-backup/

# Local agent planning artifacts (never committed).
.zcode/
